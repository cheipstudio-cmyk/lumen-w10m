<Page
    x:Class="Lumen.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <!-- 7 s loop: the mini Lumen on the Lumia screen gets a question, "thinks", streams an answer, gets a thanks, resets. -->
        <Storyboard x:Name="ScreenLoop" RepeatBehavior="Forever">
            <!-- user bubble 1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniU1" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6.0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:6.4" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniU1Move" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="40"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- thinking dots -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniDots" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.15" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniDot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniDot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.45" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.75" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniDot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.85" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- streamed answer: four lines grow left to right -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniAnswer" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6.0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:6.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniL1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.55" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniL2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.95" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniL3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.9" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:3.35" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniL4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.3" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:3.7" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- user bubble 2 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniU2" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.3" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6.0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:6.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniU2Move" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.3" Value="40"/>
                <EasingDoubleKeyFrame KeyTime="0:0:4.7" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- send button "press" when each message goes out -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniSendScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.7"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.25" Value="0.7"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.4" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniSendScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.7"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.25" Value="0.7"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.4" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- The phone floats and slowly turns in 3D -->
        <Storyboard x:Name="FloatLoop" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PhoneMove" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PhoneTilt" Storyboard.TargetProperty="RotationY" From="-14" To="14" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.06" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.06" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="FeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlipView x:Name="Pages" Background="Transparent" SelectionChanged="Pages_SelectionChanged">

            <!-- ================= 1. Hero: animated Lumia 735 ================= -->
            <FlipViewItem>
                <Grid Padding="24,12,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="Stage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,8">
                        <!-- halo -->
                        <Ellipse Width="300" Height="300" Opacity="0.22" Fill="{StaticResource AccentGradient}"
                                 RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="230" Height="230" Opacity="0.18" Fill="{StaticResource AccentGradient}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Lumia 735, green polycarbonate -->
                        <Grid x:Name="Phone" Width="186" Height="356">
                            <Grid.RenderTransform><TranslateTransform x:Name="PhoneMove"/></Grid.RenderTransform>
                            <Grid.Projection><PlaneProjection x:Name="PhoneTilt"/></Grid.Projection>

                            <Border CornerRadius="26">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF7DD445" Offset="0"/>
                                        <GradientStop Color="#FF4FB52C" Offset="0.45"/>
                                        <GradientStop Color="#FF2F8A1C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- glossy edge highlight -->
                            <Border CornerRadius="26" BorderThickness="1.5" BorderBrush="#66FFFFFF"/>
                            <!-- black front glass -->
                            <Border Margin="5" CornerRadius="22" Background="#FF07080A"/>
                            <!-- earpiece and front camera -->
                            <Border Width="44" Height="4" CornerRadius="2" Background="#FF22252B" VerticalAlignment="Top" Margin="0,18,0,0"/>
                            <Ellipse Width="7" Height="7" Fill="#FF1B1E24" Stroke="#FF2C313A" StrokeThickness="1"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,34,0"/>

                            <!-- screen -->
                            <Border Margin="12,34,12,30" Background="{StaticResource BgBrush}" CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="9:41" FontSize="7" Foreground="#FFB0B4BE" HorizontalAlignment="Right" Margin="0,1,6,0"/>

                                    <Grid Grid.Row="1" Padding="7,0,7,0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,0.5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="11" Height="11" Margin="0,0,5,0" Source="ms-appx:///Assets/Orb.png"/>
                                            <TextBlock Text="Lumen" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Padding="6,0,6,6">
                                        <Border x:Name="MiniU1" HorizontalAlignment="Right" CornerRadius="9,9,2,9" Padding="7,4"
                                                Background="{StaticResource UserBubbleBrush}" Margin="24,0,0,6" Opacity="0">
                                            <Border.RenderTransform><TranslateTransform x:Name="MiniU1Move" X="40"/></Border.RenderTransform>
                                            <TextBlock Text="Pizza dough for 2?" FontSize="8.5" Foreground="White"/>
                                        </Border>

                                        <Grid>
                                            <StackPanel x:Name="MiniDots" Orientation="Horizontal" Opacity="0" Margin="0,2,0,0" VerticalAlignment="Top">
                                                <Image Width="10" Height="10" Source="ms-appx:///Assets/Orb.png" Margin="0,0,5,0"/>
                                                <Ellipse x:Name="MiniDot1" Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="0,3,3,0">
                                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="MiniDot2" Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="0,3,3,0">
                                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="MiniDot3" Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="0,3,3,0">
                                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                                </Ellipse>
                                            </StackPanel>

                                            <Grid x:Name="MiniAnswer" Opacity="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Left" Source="ms-appx:///Assets/Orb.png" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <Border x:Name="MiniL1" Height="5" CornerRadius="2.5" Background="#FFDADDE5" Width="110" HorizontalAlignment="Left" Margin="0,2,0,4" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                                    </Border>
                                                    <Border x:Name="MiniL2" Height="5" CornerRadius="2.5" Background="#FFDADDE5" Width="96" HorizontalAlignment="Left" Margin="0,0,0,4" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                                    </Border>
                                                    <Border x:Name="MiniL3" Height="5" CornerRadius="2.5" Background="{StaticResource AccentBrush}" Width="104" HorizontalAlignment="Left" Margin="0,0,0,4" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                                    </Border>
                                                    <Border x:Name="MiniL4" Height="5" CornerRadius="2.5" Background="#FFDADDE5" Width="62" HorizontalAlignment="Left" Margin="0,0,0,6" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Border x:Name="MiniU2" HorizontalAlignment="Right" CornerRadius="9,9,2,9" Padding="7,4"
                                                Background="{StaticResource UserBubbleBrush}" Opacity="0">
                                            <Border.RenderTransform><TranslateTransform x:Name="MiniU2Move" X="40"/></Border.RenderTransform>
                                            <TextBlock Text="Perfect, thanks!" FontSize="8.5" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="3" Margin="6,2,6,4" CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0.5">
                                        <Grid>
                                            <TextBlock Text="Ask Lumen" FontSize="8" Foreground="#FF8A90A0" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            <Ellipse Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,2,0" Fill="{StaticResource AccentGradient}"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform x:Name="MiniSendScale"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- on-screen navigation bar of the 735 -->
                                    <Grid Grid.Row="4" Background="Black">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE72B;" FontSize="8" Foreground="#FFCCCCCC"/>
                                        <FontIcon Grid.Column="1" Glyph="&#xE80F;" FontSize="8" Foreground="#FFCCCCCC"/>
                                        <FontIcon Grid.Column="2" Glyph="&#xE721;" FontSize="8" Foreground="#FFCCCCCC"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="HeroText" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Lumen" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource AccentGradient}"/>
                        <TextBlock Text="Google Gemini, back on your Lumia." FontSize="19" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,6"/>
                        <TextBlock Text="Fast, free with your own key, made for Windows 10 Mobile." FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </FlipViewItem>

            <!-- ================= 2. Features ================= -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="FeaturesPanel" Padding="24,40,24,24" VerticalAlignment="Center">
                        <TextBlock Text="Everything Gemini can do" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIcon}"><FontIcon Glyph="&#xE8BD;" FontSize="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ask anything" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Answers stream in word by word, with lists, code and links." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIcon}"><FontIcon Glyph="&#xE722;" FontSize="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Snap or pick a photo" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Shoot with the camera or choose from your gallery, then ask about it." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIcon}"><FontIcon Glyph="&#xE720;" FontSize="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Just talk" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Tap the mic and send a voice message. Gemini listens and replies." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FeatureIcon}"><FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Your chats stay here" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="History lives on this phone. Your key sits in the Windows credential locker." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- ================= 3. Free API key ================= -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="KeyPanel" Padding="24,40,24,24">
                        <TextBlock Text="Get your free key" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Lumen talks to Google with your own Gemini API key. It's free and takes a minute, no credit card."
                                   Style="{StaticResource HintText}" FontSize="14" Margin="0,8,0,20"/>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="1.  Open Google AI Studio and sign in" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="2.  Tap Create API key and copy it" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="3.  Come back and paste it below" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Open Google AI Studio" Click="OpenStudio_Click" HorizontalAlignment="Stretch"
                                        Background="{StaticResource Surface2Brush}" Padding="12,10"/>
                            </StackPanel>
                        </Border>

                        <PasswordBox x:Name="KeyBox" PlaceholderText="Paste your key (AIza...)" Margin="0,20,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="VerifyButton" Content="Check key" Click="Verify_Click"
                                    Background="{StaticResource AccentGradient}" Foreground="White" Padding="18,9"/>
                            <ProgressRing x:Name="VerifyRing" Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left" Margin="12,0,0,0"
                                          Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        <TextBlock Text="You can also skip this and add the key later in Settings." Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- ================= 4. Theme ================= -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="ThemePanel" Padding="24,40,24,24">
                        <TextBlock Text="Make it yours" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Pick a color. You can change it any time in Settings." Style="{StaticResource HintText}" FontSize="14" Margin="0,8,0,18"/>

                        <GridView x:Name="Swatches" SelectionMode="Single" SelectionChanged="Swatches_SelectionChanged"
                                  IsItemClickEnabled="False" Padding="0">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="core:AccentPalette">
                                    <StackPanel Width="64" Margin="0,0,0,6">
                                        <Ellipse Width="44" Height="44" Fill="{x:Bind SwatchBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <ToggleSwitch x:Name="BlackToggle" Header="Pure black background (saves battery on AMOLED)" Toggled="BlackToggle_Toggled" Margin="0,12,0,0"/>

                        <!-- live preview -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14" Margin="0,16,0,0"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="16,16,4,16" Background="{StaticResource UserBubbleBrush}" Padding="12,8" Margin="40,0,0,10">
                                    <TextBlock Text="Is it fast on my Lumia?" Foreground="White"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="20" Height="20" Source="ms-appx:///Assets/Orb.png" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock Text="Very. Let's go!" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>
        </FlipView>

        <!-- Bottom bar: page dots, skip, next -->
        <Grid Grid.Row="1" Padding="24,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Height="8" Width="22" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource AccentGradient}"/>
                <Border Height="8" Width="8" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource StrokeBrush}"/>
                <Border Height="8" Width="8" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource StrokeBrush}"/>
                <Border Height="8" Width="8" CornerRadius="4" Background="{StaticResource StrokeBrush}"/>
            </StackPanel>
            <Button x:Name="SkipButton" Grid.Column="1" Content="Skip" Click="Skip_Click" Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" Padding="14,10"/>
            <Button x:Name="NextButton" Grid.Column="2" Click="Next_Click" Background="{StaticResource AccentGradient}"
                    Foreground="White" Padding="22,10" MinWidth="110">
                <TextBlock x:Name="NextText" Text="Next" Foreground="White" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Page>
