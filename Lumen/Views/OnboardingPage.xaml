<Page
    x:Class="Lumen.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SwatchTemplate" x:DataType="core:AccentPalette">
            <Grid Width="50" Height="50" Background="{x:Bind SwatchBrush}">
                <TextBlock Text="{x:Bind Label}" FontSize="9" Foreground="White" VerticalAlignment="Bottom" Margin="3,0,2,2" TextWrapping="Wrap"/>
                <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="3" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
                <BitmapIcon UriSource="ms-appx:///Assets/Icons/Check.png" Width="14" Height="14" Foreground="White"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="SwatchItem" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <DataTemplate x:Key="ProviderTemplate" x:DataType="core:Provider">
            <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                    <TextBlock Text="{x:Bind Initial}" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="FeatureRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlipView x:Name="Pages" Background="Transparent" SelectionChanged="Pages_SelectionChanged">

            <!-- 0. language -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="LangPanel" Padding="0,18,0,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}" Margin="12,0,12,14"/>
                        <TextBlock x:Uid="XChooseYourLanguage" Text="Choose your language" Style="{StaticResource PageTitle}" Margin="12,0,12,8"/>
                        <StackPanel x:Name="LangList"/>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 1. hero: rendered 3D Lumia 735 running Lumen -->
            <FlipViewItem>
                <Grid Background="Black">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="HeroVideo" Source="ms-appx:///Assets/Lumia735.mp4" AutoPlay="False" IsLooping="True"
                                  IsMuted="True" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                    <StackPanel x:Name="HeroText" Grid.Row="1" Padding="12,0,12,12">
                        <TextBlock Text="Lumen" FontSize="34" FontWeight="SemiLight" Foreground="White"/>
                        <TextBlock x:Uid="XGeminiClaudeAndChatgptOnYourLumia" Text="Gemini, Claude and ChatGPT on your Lumia." FontSize="17" TextWrapping="Wrap" Foreground="White"/>
                        <TextBlock x:Uid="XChatTalkSnapPhotosCreateImagesAndFilesBu" Text="Chat, talk, snap photos, create images and files. Built for Windows 10 Mobile."
                                   FontSize="13" TextWrapping="Wrap" Foreground="#FFA0A0A0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </FlipViewItem>

            <!-- 2. features -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="FeaturesPanel" Padding="12,18,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}" Margin="0,0,0,14"/>
                        <TextBlock x:Uid="XOneAppEveryAssistant" Text="One app, every assistant" Style="{StaticResource PageTitle}"/>

                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Cloud.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XPickYourAi" Text="Pick your AI" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XGoogleGeminiFreeKeyAnthropicClaudeOpenai" Text="Google Gemini (free key), Anthropic Claude, OpenAI ChatGPT or any OpenAI compatible server. Switch from the top of a chat." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Chat.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XAskAnything" Text="Ask anything" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XAnswersStreamInWordByWordWithFreeWikiped" Text="Answers stream in word by word, with free Wikipedia lookups for fresh facts." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Mic.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XJustTalk" Text="Just talk" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XSendAVoiceMessageAndHaveAnswersReadBackT" Text="Send a voice message, and have answers read back to you." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Camera.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XSnapOrPickAPhoto" Text="Snap or pick a photo" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XShootWithTheCameraOrChooseFromYourGaller" Text="Shoot with the camera or choose from your gallery, then ask about it." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/ImageSparkle.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XCreateImagesAndFiles" Text="Create images and files" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XAskForAPictureOrADocumentAndGetItInTheCh" Text="Ask for a picture or a document and get it in the chat, ready to save or share." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Lock.png" Width="20" Height="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XPrivateByDesign" Text="Private by design" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XChatsStayOnThisPhoneKeysSitInTheWindowsC" Text="Chats stay on this phone. Keys sit in the Windows credential locker and go only to the service you pick." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 3. connect -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="KeyPanel" Padding="12,18,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}" Margin="0,0,0,14"/>
                        <TextBlock x:Uid="XConnectAnAiService" Text="Connect an AI service" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Uid="XLumenTalksToTheServiceWithYourOwnApiKeyG" Text="Lumen talks to the service with your own API key. Gemini has a free key that takes a minute, no credit card."
                                   Style="{StaticResource HintText}" FontSize="14" Margin="0,0,0,12"/>

                        <ComboBox x:Uid="XServiceHeader" x:Name="ProviderCombo" Header="Service" HorizontalAlignment="Stretch"
                                  ItemTemplate="{StaticResource ProviderTemplate}" SelectionChanged="ProviderCombo_SelectionChanged"/>
                        <TextBlock x:Name="ProviderHint" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                        <Button x:Uid="XGetAKeyContent" x:Name="GetKeyButton" Content="Get a key" Click="OpenStudio_Click" Style="{StaticResource AccentButton}" Margin="0,6,0,14"/>

                        <TextBox x:Uid="XApiEndpointHeader" x:Name="EndpointBox" Header="API endpoint" IsSpellCheckEnabled="False" InputScope="Url" Margin="0,0,0,12"
                                 PlaceholderText="https://openrouter.ai/api/v1" Visibility="Collapsed"/>
                        <PasswordBox x:Uid="XApiKeyHeader" x:Name="KeyBox" Header="API key"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Uid="XCheckKeyContent" x:Name="VerifyButton" Content="Check key" Click="Verify_Click" Style="{StaticResource AccentButton}"/>
                            <ProgressRing x:Name="VerifyRing" Width="22" Height="22" Margin="14,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        <TextBlock x:Uid="XYouCanAlsoSkipThisAndAddKeysLaterInSetti" Text="You can also skip this and add keys later in Settings." Style="{StaticResource HintText}"/>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 4. theme -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="ThemePanel" Padding="12,18,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}" Margin="0,0,0,14"/>
                        <TextBlock x:Uid="XMakeItYours" Text="Make it yours" Style="{StaticResource PageTitle}"/>
                        <ToggleSwitch x:Uid="XLightThemeHeader" x:Name="ThemeToggle" Header="Light theme" Toggled="ThemeToggle_Toggled"/>
                        <TextBlock x:Uid="XChooseYourAccentColor" Text="Choose your accent color" Style="{StaticResource SectionHeader}" Margin="0,12,0,8"/>
                        <GridView x:Name="Swatches" ItemTemplate="{StaticResource SwatchTemplate}" ItemContainerStyle="{StaticResource SwatchItem}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatches_ItemClick" Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                        <!-- live preview -->
                        <StackPanel Margin="0,14,0,0">
                            <StackPanel HorizontalAlignment="Right" Margin="60,0,0,6">
                                <Border Background="{StaticResource UserBubbleSolid}" Padding="12,8">
                                    <TextBlock x:Uid="XIsItFastOnMyLumia" Text="Is it fast on my Lumia?" Foreground="White"/>
                                </Border>
                                <Polygon Points="0,0 16,0 16,12" Fill="{StaticResource UserBubbleSolid}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Left" Margin="0,0,60,0">
                                <Polygon Points="0,0 0,12 16,12" Fill="{StaticResource ModelBubbleSolid}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                <Border Background="{StaticResource ModelBubbleSolid}" Padding="12,8">
                                    <TextBlock x:Uid="XVeryLetSGo" Text="Very. Let's go!" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>
        </FlipView>

        <!-- Bottom bar: page dots, skip, next (W10M setup style) -->
        <Grid Grid.Row="1" Background="{StaticResource ChromeBrush}" Padding="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Height="7" Width="7" Margin="0,0,6,0" Fill="{StaticResource AccentBrush}"/>
                <Ellipse Height="7" Width="7" Margin="0,0,6,0" Fill="{StaticResource StrokeBrush}"/>
                <Ellipse Height="7" Width="7" Margin="0,0,6,0" Fill="{StaticResource StrokeBrush}"/>
                <Ellipse Height="7" Width="7" Margin="0,0,6,0" Fill="{StaticResource StrokeBrush}"/>
                <Ellipse Height="7" Width="7" Fill="{StaticResource StrokeBrush}"/>
            </StackPanel>
            <Button x:Uid="XSkipContent" x:Name="SkipButton" Grid.Column="1" Content="Skip" Click="Skip_Click" Style="{StaticResource ChipButton}" MinHeight="34" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="NextButton" Grid.Column="2" Click="Next_Click" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Uid="XNext" x:Name="NextText" Text="Next"/>
                    <BitmapIcon x:Name="NextIcon" UriSource="ms-appx:///Assets/Icons/ChevronRight.png" Width="14" Height="14" Margin="8,1,0,0" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
