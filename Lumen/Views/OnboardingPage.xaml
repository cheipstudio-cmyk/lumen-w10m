<Page
    x:Class="Lumen.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="Black">

    <Page.Resources>
        <Style x:Key="FeatureRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlipView x:Name="Pages" Background="Transparent" SelectionChanged="Pages_SelectionChanged">

            <!-- ================= 1. Hero: rendered 3D Lumia 735 running Lumen ================= -->
            <FlipViewItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- H.264 loop, hardware-decoded on the phone. Black background matches the page. -->
                    <MediaElement x:Name="HeroVideo" Source="ms-appx:///Assets/Lumia735.mp4" AutoPlay="True" IsLooping="True"
                                  IsMuted="True" AreTransportControlsEnabled="False" Stretch="Uniform" Margin="0,8,0,0"/>
                    <StackPanel x:Name="HeroText" Grid.Row="1" Padding="24,0,24,12">
                        <TextBlock Text="Lumen" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource AccentGradient}"/>
                        <TextBlock Text="Google Gemini, back on your Lumia." FontSize="20" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Chat, talk, snap photos, create images and files. Built for Windows 10 Mobile."
                                   FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </FlipViewItem>

            <!-- ================= 2. Features ================= -->
            <FlipViewItem>
                <Grid Background="{StaticResource AuroraBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="FeaturesPanel" Padding="24,48,24,24">
                            <TextBlock Text="Everything Gemini can do" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,28"/>

                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="15"><FontIcon Style="{StaticResource Icon}" Glyph="&#xF287;" FontSize="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ask anything" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Answers stream in word by word, and Gemini checks Wikipedia for fresh facts." Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="15"><FontIcon Style="{StaticResource Icon}" Glyph="&#xE7FA;" FontSize="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Just talk" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Send a voice message, and have answers read back to you." Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="15"><FontIcon Style="{StaticResource Icon}" Glyph="&#xF255;" FontSize="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Snap or pick a photo" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Shoot with the camera or choose from your gallery, then ask about it." Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="15"><FontIcon Style="{StaticResource Icon}" Glyph="&#xF01F2;" FontSize="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Create images and files" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Ask for a picture or a document: Lumen picks the right model and hands you the result to save or share." Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="15"><FontIcon Style="{StaticResource Icon}" Glyph="&#xE790;" FontSize="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Private by design" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Chats stay on this phone. Your key sits in the Windows credential locker." Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </FlipViewItem>

            <!-- ================= 3. Free API key ================= -->
            <FlipViewItem>
                <Grid Background="{StaticResource AuroraBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="KeyPanel" Padding="24,48,24,24">
                            <TextBlock Text="Connect Gemini" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Lumen talks to Google with your own Gemini API key. The free key takes a minute, no credit card. A paid key unlocks bigger models and image creation."
                                       Style="{StaticResource HintText}" FontSize="14" Margin="0,8,0,20"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadge}" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"><TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="Open Google AI Studio and sign in" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadge}" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"><TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="Tap Create API key and copy it" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadge}" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"><TextBlock Text="3" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="Come back and paste it below" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Style="{StaticResource ChipButton}" Click="OpenStudio_Click" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Style="{StaticResource Icon}" Glyph="&#xF583;" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Open Google AI Studio" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource Icon}" Glyph="&#xF4B7;" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="4,0,8,0"/>
                                    <PasswordBox x:Name="KeyBox" Grid.Column="1" PlaceholderText="Paste your key (AIza...)" BorderThickness="0" Background="Transparent"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VerifyButton" Click="Verify_Click" Style="{StaticResource AccentButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Style="{StaticResource Icon}" Glyph="&#xF299;" FontSize="17" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="Check key" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <ProgressRing x:Name="VerifyRing" Width="22" Height="22" Margin="14,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                            <TextBlock Text="You can also skip this and add the key later in Settings." Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </FlipViewItem>

            <!-- ================= 4. Theme ================= -->
            <FlipViewItem>
                <Grid Background="{StaticResource AuroraBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="ThemePanel" Padding="24,48,24,24">
                            <TextBlock Text="Make it yours" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Pick a color. The background, bubbles and buttons follow it." Style="{StaticResource HintText}" FontSize="14" Margin="0,8,0,18"/>

                            <GridView x:Name="Swatches" SelectionMode="Single" SelectionChanged="Swatches_SelectionChanged" Padding="0">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="core:AccentPalette">
                                        <StackPanel Width="66" Margin="0,0,0,8">
                                            <Ellipse Width="46" Height="46" Fill="{x:Bind SwatchBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <Border Style="{StaticResource Card}" Margin="0,8,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Center"><FontIcon Style="{StaticResource Icon}" Glyph="&#xF33C;" FontSize="18" Foreground="White"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Pure black" FontWeight="SemiBold"/>
                                        <TextBlock Text="Saves battery on AMOLED" Style="{StaticResource HintText}" Margin="0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="BlackToggle" Grid.Column="2" Toggled="BlackToggle_Toggled" OnContent="" OffContent="" MinWidth="0" Width="56"/>
                                </Grid>
                            </Border>

                            <!-- live preview -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="18,18,6,18" Background="{StaticResource UserBubbleBrush}" Padding="12,8" Margin="40,0,0,10">
                                        <TextBlock Text="Is it fast on my Lumia?" Foreground="White"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="22" Height="22" Source="ms-appx:///Assets/Orb.png" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                        <TextBlock Text="Very. Let's go!" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </FlipViewItem>
        </FlipView>

        <!-- Bottom bar: page dots, skip, next -->
        <Grid Grid.Row="1" Padding="24,8,16,16" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Height="8" Width="24" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource AccentGradient}"/>
                <Border Height="8" Width="8" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource StrokeBrush}"/>
                <Border Height="8" Width="8" CornerRadius="4" Margin="0,0,6,0" Background="{StaticResource StrokeBrush}"/>
                <Border Height="8" Width="8" CornerRadius="4" Background="{StaticResource StrokeBrush}"/>
            </StackPanel>
            <Button x:Name="SkipButton" Grid.Column="1" Content="Skip" Click="Skip_Click" Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" Padding="14,10" BorderThickness="0"/>
            <Button x:Name="NextButton" Grid.Column="2" Click="Next_Click" Style="{StaticResource AccentButton}" MinWidth="118">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NextText" Text="Next" Foreground="White" FontWeight="SemiBold"/>
                    <FontIcon Style="{StaticResource Icon}" x:Name="NextIcon" Glyph="&#xF2B1;" FontSize="15" Foreground="White" Margin="8,1,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
