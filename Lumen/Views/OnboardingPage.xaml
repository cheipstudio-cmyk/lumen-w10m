<Page
    x:Class="Lumen.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SwatchTemplate" x:DataType="core:AccentPalette">
            <Grid Width="58" Height="58" Background="{x:Bind SwatchBrush}">
                <TextBlock Text="{x:Bind Label}" FontSize="10" Foreground="White" VerticalAlignment="Bottom" Margin="4,0,2,3" TextWrapping="Wrap"/>
                <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="3" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
                <BitmapIcon UriSource="ms-appx:///Assets/Icons/Check.png" Width="16" Height="16" Foreground="White"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="SwatchItem" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style x:Key="FeatureRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar x:Name="BottomBar">
            <AppBarButton x:Uid="XlSkipLabel" x:Name="SkipButton" Label="skip" Click="Skip_Click">
                <AppBarButton.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Dismiss.png"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="XlNextLabel" x:Name="NextButton" Label="next" Click="Next_Click">
                <AppBarButton.Icon><BitmapIcon x:Name="NextIcon" UriSource="ms-appx:///Assets/Icons/ChevronRight.png"/></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <FlipView x:Name="Pages" Background="Transparent" SelectionChanged="Pages_SelectionChanged">

            <!-- 0. language -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="LangPanel" Padding="12,14,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}"/>
                        <TextBlock x:Uid="XChooseYourLanguage" Text="Choose your language" Style="{StaticResource PageTitle}"/>
                        <StackPanel x:Name="LangList" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 1. hero: rendered 3D Lumia 735 running Lumen -->
            <FlipViewItem>
                <Grid Background="Black">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="HeroVideo" Source="ms-appx:///Assets/Lumia735.mp4" AutoPlay="False" IsLooping="True"
                                  IsMuted="True" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                    <StackPanel x:Name="HeroText" Grid.Row="1" Padding="12,0,12,16">
                        <TextBlock Text="lumen" FontSize="56" FontWeight="Light" Foreground="White" Margin="-3,-10,0,-4"/>
                        <TextBlock x:Uid="XGoogleGeminiBackOnYourLumia" Text="Google Gemini, back on your Lumia." FontSize="20" FontWeight="SemiLight" TextWrapping="Wrap" Foreground="White"/>
                        <TextBlock x:Uid="XChatTalkSnapPhotosCreateImagesAndFilesBu" Text="Chat, talk, snap photos, create images and files. Built for Windows 10 Mobile."
                                   FontSize="14" TextWrapping="Wrap" Foreground="#FF9A9A9A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </FlipViewItem>

            <!-- 2. features -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="FeaturesPanel" Padding="12,14,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}"/>
                        <TextBlock x:Uid="XEverythingGeminiCanDo" Text="Everything Gemini can do" Style="{StaticResource PageTitle}"/>

                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Width="56" Height="56"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Chat.png" Width="28" Height="28" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XAskAnything" Text="Ask anything" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XAnswersStreamInWordByWordAndGeminiChecks" Text="Answers stream in word by word, and Gemini checks Wikipedia for fresh facts." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Width="56" Height="56"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Mic.png" Width="28" Height="28" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XJustTalk" Text="Just talk" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XSendAVoiceMessageAndHaveAnswersReadBackT" Text="Send a voice message, and have answers read back to you." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Width="56" Height="56"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Camera.png" Width="28" Height="28" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XSnapOrPickAPhoto" Text="Snap or pick a photo" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XShootWithTheCameraOrChooseFromYourGaller" Text="Shoot with the camera or choose from your gallery, then ask about it." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource FeatureRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Width="56" Height="56"><BitmapIcon UriSource="ms-appx:///Assets/Icons/ImageSparkle.png" Width="28" Height="28" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XCreateImagesAndFiles" Text="Create images and files" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XAskForAPictureOrADocumentLumenPicksTheRi" Text="Ask for a picture or a document: Lumen picks the right model and hands you the result to save or share." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Width="56" Height="56"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Lock.png" Width="28" Height="28" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XPrivateByDesign" Text="Private by design" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XChatsStayOnThisPhoneYourKeySitsInTheWind" Text="Chats stay on this phone. Your key sits in the Windows credential locker." Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 3. key -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="KeyPanel" Padding="12,14,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}"/>
                        <TextBlock x:Uid="XConnectGemini" Text="Connect Gemini" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Uid="XLumenTalksToGoogleWithYourOwnGeminiApiKe" Text="Lumen talks to Google with your own Gemini API key. The free key takes a minute, no credit card. A paid key unlocks bigger models and image creation."
                                   Style="{StaticResource HintText}" FontSize="15" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="1" FontSize="30" FontWeight="Light" Foreground="{StaticResource AccentBrush}" Width="30"/>
                            <TextBlock x:Uid="XOpenGoogleAiStudioAndSignIn" Grid.Column="1" Text="Open Google AI Studio and sign in" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="2" FontSize="30" FontWeight="Light" Foreground="{StaticResource AccentBrush}" Width="30"/>
                            <TextBlock x:Uid="XTapCreateApiKeyAndCopyIt" Grid.Column="1" Text="Tap Create API key and copy it" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="3" FontSize="30" FontWeight="Light" Foreground="{StaticResource AccentBrush}" Width="30"/>
                            <TextBlock x:Uid="XComeBackAndPasteItBelow" Grid.Column="1" Text="Come back and paste it below" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <Button x:Uid="XOpenGoogleAiStudioContent" Content="Open Google AI Studio" Click="OpenStudio_Click" Style="{StaticResource AccentButton}" Margin="0,0,0,18"/>

                        <PasswordBox x:Uid="XPasteYourKeyAizaPlaceholderText" x:Name="KeyBox" PlaceholderText="Paste your key (AIza...)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Uid="XCheckKeyContent" x:Name="VerifyButton" Content="Check key" Click="Verify_Click" Style="{StaticResource AccentButton}"/>
                            <ProgressRing x:Name="VerifyRing" Width="22" Height="22" Margin="14,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                        <TextBlock x:Uid="XYouCanAlsoSkipThisAndAddTheKeyLaterInSet" Text="You can also skip this and add the key later in Settings." Style="{StaticResource HintText}"/>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>

            <!-- 4. theme -->
            <FlipViewItem>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="ThemePanel" Padding="12,14,12,24">
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}"/>
                        <TextBlock x:Uid="XMakeItYours" Text="Make it yours" Style="{StaticResource PageTitle}"/>
                        <ToggleSwitch x:Uid="XLightThemeHeader" x:Name="ThemeToggle" Header="Light theme" Toggled="ThemeToggle_Toggled"/>
                        <TextBlock x:Uid="XAccentColor" Text="Accent color" Margin="0,12,0,8"/>
                        <GridView x:Name="Swatches" ItemTemplate="{StaticResource SwatchTemplate}" ItemContainerStyle="{StaticResource SwatchItem}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatches_ItemClick" Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

                        <!-- live preview -->
                        <StackPanel Margin="0,14,0,0">
                            <StackPanel HorizontalAlignment="Right" Margin="60,0,0,6">
                                <Border Background="{StaticResource UserBubbleSolid}" Padding="12,8">
                                    <TextBlock x:Uid="XIsItFastOnMyLumia" Text="Is it fast on my Lumia?" Foreground="White"/>
                                </Border>
                                <Polygon Points="0,0 16,0 16,12" Fill="{StaticResource UserBubbleSolid}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Left" Margin="0,0,60,0">
                                <Polygon Points="0,0 0,12 16,12" Fill="{StaticResource ModelBubbleSolid}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                <Border Background="{StaticResource ModelBubbleSolid}" Padding="12,8">
                                    <TextBlock x:Uid="XVeryLetSGo" Text="Very. Let's go!" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </FlipViewItem>
        </FlipView>

        <!-- page dots: small squares, top right -->
        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,14,0">
            <Border Height="6" Width="6" Margin="0,0,5,0" Background="{StaticResource AccentBrush}"/>
            <Border Height="6" Width="6" Margin="0,0,5,0" Background="{StaticResource StrokeBrush}"/>
            <Border Height="6" Width="6" Margin="0,0,5,0" Background="{StaticResource StrokeBrush}"/>
            <Border Height="6" Width="6" Margin="0,0,5,0" Background="{StaticResource StrokeBrush}"/>
            <Border Height="6" Width="6" Background="{StaticResource StrokeBrush}"/>
        </StackPanel>
    </Grid>
</Page>
