<Page
    x:Class="Lumen.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Height="56" Padding="4,0,4,0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="Back_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="18"/>
            </Button>
            <TextBlock Grid.Column="1" Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Root" Padding="16,0,16,32" MaxWidth="560">

                <!-- Key -->
                <TextBlock Text="GEMINI API KEY" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Free from Google AI Studio. It stays on this phone, in the Windows credential locker."/>
                <PasswordBox x:Name="ApiKeyBox" PlaceholderText="AIza..."/>
                <HyperlinkButton Content="Get a free key on Google AI Studio" NavigateUri="https://aistudio.google.com/apikey" Margin="0,6,0,0"
                                 Foreground="{StaticResource AccentBrush}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="VerifyButton" Content="Check key and load models" Click="Verify_Click"
                            Background="{StaticResource AccentGradient}" Foreground="White" Padding="16,8"/>
                    <ProgressRing x:Name="VerifyRing" Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left" Margin="12,0,0,0"
                                  Foreground="{StaticResource AccentBrush}"/>
                </Grid>
                <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,8,0,0"/>

                <!-- Model -->
                <TextBlock Text="MODEL" Style="{StaticResource SectionHeader}"/>
                <ComboBox x:Name="ModelsCombo" HorizontalAlignment="Stretch" SelectionChanged="ModelsCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ModelInfo">
                            <StackPanel>
                                <TextBlock Text="{x:Bind DisplayName}"/>
                                <TextBlock Text="{x:Bind Id}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                           Text="Flash-Lite is the fastest and has the biggest free daily quota. Check your key to see every model it can use."/>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Accent color" Margin="0,0,0,8"/>
                <GridView x:Name="Swatches" SelectionMode="Single" SelectionChanged="Swatches_SelectionChanged" Padding="0">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="core:AccentPalette">
                            <StackPanel Width="64" Margin="0,0,0,6">
                                <Ellipse Width="40" Height="40" Fill="{x:Bind SwatchBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ToggleSwitch x:Name="BlackToggle" Header="Pure black background" Toggled="BlackToggle_Toggled" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource HintText}" Text="True black pixels are switched off on the Lumia's AMOLED screen and save battery."/>

                <TextBlock Text="Text size" Margin="0,12,0,6"/>
                <ComboBox x:Name="TextSizeCombo" HorizontalAlignment="Stretch" SelectionChanged="TextSizeCombo_SelectionChanged">
                    <x:String>Small</x:String>
                    <x:String>Normal</x:String>
                    <x:String>Large</x:String>
                </ComboBox>

                <ToggleSwitch x:Name="AnimToggle" Header="Animations" Toggled="AnimToggle_Toggled" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource HintText}" Text="Switches and sliders pick up a new color, and page transitions follow this setting, the next time you open Lumen."/>

                <!-- Assistant -->
                <TextBlock Text="ASSISTANT" Style="{StaticResource SectionHeader}"/>
                <ToggleSwitch x:Name="WikiToggle" Header="Look things up on Wikipedia" Toggled="WikiToggle_Toggled"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Free and unlimited. Gemini searches Wikipedia by itself for recent products, people and events, and tells you which page it used. Google Search isn't available on the free Gemini plan."/>

                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Creativity"/>
                    <TextBlock x:Name="TempValue" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
                <Slider x:Name="TempSlider" Minimum="0" Maximum="2" StepFrequency="0.1" ValueChanged="TempSlider_ValueChanged"/>

                <TextBlock Text="Custom instructions" Margin="0,8,0,6"/>
                <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                         PlaceholderText="Leave empty for the default: concise answers in your language."/>

                <!-- Advanced -->
                <TextBlock Text="ADVANCED" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="API endpoint. Change it only to go through your own proxy (for example a Cloudflare Worker) if the phone can't reach Google directly."/>
                <TextBox x:Name="BaseUrlBox" IsSpellCheckEnabled="False" InputScope="Url"/>

                <!-- Data -->
                <TextBlock Text="DATA" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Delete all chats" Click="DeleteAll_Click" Foreground="#FFFF8A80" Margin="0,0,8,0"/>
                    <Button Content="Show welcome tour" Click="Tour_Click"/>
                </StackPanel>

                <TextBlock x:Name="AboutText" Style="{StaticResource HintText}" Margin="0,28,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
