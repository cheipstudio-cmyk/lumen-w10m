<Page
    x:Class="Lumen.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <!-- Square accent tiles, Windows Phone style: white frame + check on the selected one -->
        <DataTemplate x:Key="SwatchTemplate" x:DataType="core:AccentPalette">
            <Grid Width="58" Height="58" Background="{x:Bind SwatchBrush}">
                <TextBlock Text="{x:Bind Label}" FontSize="10" Foreground="White" VerticalAlignment="Bottom" Margin="4,0,2,3" TextWrapping="Wrap"/>
                <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="3" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
                <BitmapIcon UriSource="ms-appx:///Assets/Icons/Check.png" Width="16" Height="16" Foreground="White"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="SwatchItem" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="12,14,12,40" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}"/>
            <TextBlock x:Uid="XlSettings" Text="settings" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,-6,0,4">
                <BitmapIcon x:Name="KeyStateIcon" UriSource="ms-appx:///Assets/Icons/CheckCircle.png" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="KeyStateText" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ===== account ===== -->
            <TextBlock x:Uid="XlAccount" Text="account" Style="{StaticResource SectionHeader}"/>
            <PasswordBox x:Uid="XGeminiApiKeyHeader" x:Name="ApiKeyBox" Header="Gemini API key" PlaceholderText="AIza..."/>
            <TextBlock x:Uid="XFreeFromGoogleAiStudioOrAPaidKeyForBigge" Style="{StaticResource HintText}" Text="Free from Google AI Studio, or a paid key for bigger models and image creation. Stored in the Windows credential locker."/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Uid="XCheckKeyContent" x:Name="VerifyButton" Content="Check key" Click="Verify_Click" Style="{StaticResource AccentButton}"/>
                <ProgressRing x:Name="VerifyRing" Width="22" Height="22" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <TextBlock x:Name="VerifyStatus" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
            <HyperlinkButton x:Uid="XGetAFreeKeyContent" Content="Get a free key" Click="GetKey_Click" Foreground="{StaticResource AccentBrush}" Padding="0,4"/>

            <!-- ===== model ===== -->
            <TextBlock x:Uid="XlModel" Text="model" Style="{StaticResource SectionHeader}"/>
            <ComboBox x:Uid="XChatModelHeader" x:Name="ModelsCombo" Header="Chat model" HorizontalAlignment="Stretch" SelectionChanged="ModelsCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:ModelInfo">
                        <StackPanel Padding="0,2">
                            <TextBlock Text="{x:Bind DisplayName}"/>
                            <TextBlock Text="{x:Bind Id}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Uid="XFlashLiteIsTheFastestWithTheBiggestFreeQ" Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="Flash-Lite is the fastest with the biggest free quota. Check your key to list every model it can use."/>
            <TextBlock x:Name="ImageModelText" Style="{StaticResource HintText}"/>

            <!-- ===== appearance ===== -->
            <TextBlock x:Uid="XlAppearance" Text="appearance" Style="{StaticResource SectionHeader}"/>
            <ComboBox x:Uid="XLanguageHeader" x:Name="LanguageCombo" Header="Language" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged"/>
            <ToggleSwitch x:Uid="XLightThemeHeader" x:Name="ThemeToggle" Header="Light theme" Toggled="ThemeToggle_Toggled" Margin="0,12,0,0"/>
            <TextBlock x:Uid="XAccentColor" Text="Accent color" Margin="0,12,0,8"/>
            <GridView x:Name="Swatches" ItemTemplate="{StaticResource SwatchTemplate}" ItemContainerStyle="{StaticResource SwatchItem}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatches_ItemClick" Padding="0"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            <ComboBox x:Uid="XTextSizeHeader" x:Name="TextSizeCombo" Header="Text size" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="TextSizeCombo_SelectionChanged"/>
            <ToggleSwitch x:Uid="XAnimationsHeader" x:Name="AnimToggle" Header="Animations" Toggled="AnimToggle_Toggled" Margin="0,12,0,0"/>

            <!-- ===== assistant ===== -->
            <TextBlock x:Uid="XlAssistant" Text="assistant" Style="{StaticResource SectionHeader}"/>
            <ToggleSwitch x:Uid="XWikipediaLookupsHeader" x:Name="WikiToggle" Header="Wikipedia lookups" Toggled="WikiToggle_Toggled"/>
            <TextBlock x:Uid="XFreeFreshFactsGoogleSearchIsnTInTheFreeP" Style="{StaticResource HintText}" Text="Free fresh facts. Google Search isn't in the free plan."/>
            <ToggleSwitch x:Uid="XImagesAndFilesHeader" x:Name="CreativeToggle" Header="Images and files" Toggled="CreativeToggle_Toggled" Margin="0,8,0,0"/>
            <TextBlock x:Uid="XAskForAPictureOrADocumentAndGetItInTheCh" Style="{StaticResource HintText}" Text="Ask for a picture or a document and get it in the chat"/>
            <Grid Margin="0,12,0,0">
                <TextBlock x:Uid="XCreativity" Text="Creativity"/>
                <TextBlock x:Name="TempValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="TempSlider" Minimum="0" Maximum="2" StepFrequency="0.1" ValueChanged="TempSlider_ValueChanged"/>
            <ComboBox x:Uid="XReadAloudVoiceHeader" x:Name="VoiceCombo" Header="Read-aloud voice" HorizontalAlignment="Stretch" SelectionChanged="VoiceCombo_SelectionChanged"/>
            <TextBox x:Uid="XEmptyDefaultConciseAnswersInYourLanguagePlaceholderText" x:Name="PromptBox" Header="Custom instructions" AcceptsReturn="True" TextWrapping="Wrap" Height="110" Margin="0,12,0,0"
                     PlaceholderText="Empty = default: concise answers in your language."/>

            <!-- ===== advanced ===== -->
            <TextBlock x:Uid="XlAdvanced" Text="advanced" Style="{StaticResource SectionHeader}"/>
            <TextBox x:Uid="XApiEndpointHeader" x:Name="BaseUrlBox" Header="API endpoint" IsSpellCheckEnabled="False" InputScope="Url"/>
            <TextBlock x:Uid="XOnlyChangeItToGoThroughYourOwnProxyEGACl" Style="{StaticResource HintText}" Text="Only change it to go through your own proxy (e.g. a Cloudflare Worker)."/>

            <!-- ===== data ===== -->
            <TextBlock x:Uid="XlData" Text="data" Style="{StaticResource SectionHeader}"/>
            <TextBlock x:Uid="XCalculating" x:Name="UsageText" Style="{StaticResource HintText}" Text="Calculating..."/>
            <Button Style="{StaticResource ChipButton}" Click="DeleteAll_Click">
                <StackPanel Orientation="Horizontal">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Delete.png" Width="20" Height="20" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Uid="XDeleteAllChats" Text="Delete all chats" FontSize="17" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Click="Tour_Click">
                <StackPanel Orientation="Horizontal">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Phone.png" Width="20" Height="20" Margin="0,0,12,0"/>
                    <TextBlock x:Uid="XWelcomeTour" Text="Welcome tour" FontSize="17"/>
                </StackPanel>
            </Button>

            <!-- ===== about ===== -->
            <TextBlock x:Uid="XlAbout" Text="about" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Image Width="56" Height="56" Source="ms-appx:///Assets/Orb.png" Margin="0,0,14,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="AboutTitle" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Uid="XUnofficialClientNotAffiliatedWithGoogleG" Style="{StaticResource HintText}" Text="Unofficial client, not affiliated with Google. Gemini is a trademark of Google LLC. Icons: Fluent System Icons (MIT)."/>
                    <HyperlinkButton x:Uid="XSourceOnGithubContent" Content="Source on GitHub" NavigateUri="https://github.com/cheipstudio-cmyk/lumen-w10m" Foreground="{StaticResource AccentBrush}" Padding="0,4"/>
                    <HyperlinkButton Content="@second_dream___" NavigateUri="https://www.instagram.com/second_dream___" Foreground="{StaticResource AccentBrush}" Padding="0,4"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
