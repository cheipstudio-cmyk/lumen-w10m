<Page
    x:Class="Lumen.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- User message: gradient bubble on the right -->
        <DataTemplate x:Key="UserTemplate" x:DataType="core:ChatMessage">
            <Grid Margin="56,6,12,6" HorizontalAlignment="Right">
                <Border CornerRadius="18,18,4,18" Background="{StaticResource UserBubbleBrush}" Padding="12,9,12,10">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="MenuCopy" Text="Copy" Click="CopyMessage_Click"/>
                            <MenuFlyoutItem x:Uid="MenuEdit" Text="Edit" Click="EditMessage_Click"/>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <StackPanel>
                        <Image Source="{x:Bind Thumb}" Visibility="{x:Bind ImageVisibility}"
                               MaxHeight="240" MaxWidth="240" Stretch="Uniform" Margin="0,3,0,6"/>
                        <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind TextVisibility}"
                                   TextWrapping="Wrap" Foreground="White" FontSize="15" IsTextScaleFactorEnabled="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Model message: no bubble, full width, orb avatar. Plain TextBlock while streaming, markdown when done. -->
        <DataTemplate x:Key="ModelTemplate" x:DataType="core:ChatMessage">
            <Grid Margin="12,10,16,10" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="MenuCopy" Text="Copy" Click="CopyMessage_Click"/>
                        <MenuFlyoutItem x:Uid="MenuShare" Text="Share" Click="ShareMessage_Click"/>
                        <MenuFlyoutItem x:Uid="MenuRegenerate" Text="Regenerate" Click="Regenerate_Click"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/Orb.png" DecodePixelWidth="44"/>
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="1">
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                 Foreground="{StaticResource AccentGradient}" Background="Transparent"
                                 Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind StreamingVisibility, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <RichTextBlock core:Markdown.Source="{Binding RenderedText}" Visibility="{x:Bind RenderedVisibility, Mode=OneWay}"
                                   FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                                   IsTextSelectionEnabled="False" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="14" Foreground="#FFFF8A80"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <core:MessageTemplateSelector x:Key="MessageSelector"
                                      UserTemplate="{StaticResource UserTemplate}"
                                      ModelTemplate="{StaticResource ModelTemplate}"/>

        <Style x:Key="FlatListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
    </Page.Resources>

    <SplitView x:Name="Drawer" DisplayMode="Overlay" OpenPaneLength="300"
               PaneBackground="{StaticResource SurfaceBrush}" IsPaneOpen="False">

        <!-- ============ Drawer: conversation history ============ -->
        <SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="16,12,8,4">
                    <TextBlock x:Uid="DrawerTitle" Text="Chats" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <Button Grid.Row="1" Style="{StaticResource ChipButton}" Margin="12,8,12,8" Click="NewChat_Click">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock x:Uid="NewChatButton" Text="New chat"/>
                    </StackPanel>
                </Button>
                <ListView x:Name="ConversationsList" Grid.Row="2" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="Conversation_ItemClick"
                          ShowsScrollingPlaceholders="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="16,10"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:ConversationInfo">
                            <Grid Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="MenuDelete" Text="Delete" Click="DeleteConversation_Click"/>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="15"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind UpdatedLabel, Mode=OneWay}" Margin="8,0,0,0"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </SplitView.Pane>

        <!-- ============ Main chat ============ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Height="56" Padding="4,0,4,0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Click="Menu_Click">
                    <FontIcon Glyph="&#xE700;" FontSize="18"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="Lumen" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModelLabel" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="NewChat_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="18"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="Settings_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="18"/>
                </Button>
            </Grid>

            <!-- Messages -->
            <ListView x:Name="MessagesList" Grid.Row="1"
                      ItemTemplateSelector="{StaticResource MessageSelector}"
                      ItemContainerStyle="{StaticResource FlatListItem}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ShowsScrollingPlaceholders="False" Padding="0,8,0,12">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent"/>
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition/>
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
            </ListView>

            <!-- Empty state -->
            <ScrollViewer x:Name="EmptyState" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel VerticalAlignment="Center" Padding="20,24,20,24" MaxWidth="520">
                    <Image Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/Orb.png" DecodePixelWidth="128"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="GreetingText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentGradient}"/>
                    <TextBlock x:Uid="EmptySubtitle" Text="What can I help with today?" FontSize="22"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,24"/>

                    <!-- Missing API key card -->
                    <Border x:Name="NoKeyCard" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Uid="NoKeyTitle" Text="You need a free API key" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="NoKeyBody" Style="{StaticResource HintText}" Margin="0,6,0,12"
                                       Text="Create one in a minute on Google AI Studio, then paste it in Settings."/>
                            <Button x:Uid="NoKeyButton" Content="Set up" Click="Settings_Click"
                                    Background="{StaticResource AccentGradient}" Foreground="White" Padding="18,8"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SuggestionsPanel">
                        <Button x:Name="Suggest1" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                        <Button x:Name="Suggest2" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                        <Button x:Name="Suggest3" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                        <Button x:Name="Suggest4" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Composer -->
            <Grid Grid.Row="2" Background="{StaticResource BgBrush}" Padding="8,6,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="AttachmentPreview" Visibility="Collapsed" Margin="8,0,0,8" HorizontalAlignment="Left">
                    <Border CornerRadius="12" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <Image x:Name="AttachmentImage" Width="72" Height="72" Stretch="UniformToFill"/>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,-8,-8,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource Surface2Brush}" Click="RemoveAttachment_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="26"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Click="Attach_Click">
                            <FontIcon Glyph="&#xE722;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <TextBox x:Name="InputBox" x:Uid="InputBox" Grid.Column="1" PlaceholderText="Ask Lumen"
                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="132" FontSize="15"
                                 VerticalAlignment="Center" BorderThickness="0" Padding="6,10,6,10"
                                 TextChanged="InputBox_TextChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Chat"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFECEEF3"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF9AA0B0"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9AA0B0"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF9AA0B0"/>
                            </TextBox.Resources>
                        </TextBox>
                        <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Bottom"
                                Background="{StaticResource AccentGradient}" Foreground="White" Click="Send_Click" IsEnabled="False">
                            <FontIcon x:Name="SendGlyph" Glyph="&#xE724;" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Lightweight toast -->
            <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Background="{StaticResource Surface2Brush}" CornerRadius="16" Padding="14,7" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="13"/>
            </Border>
        </Grid>
    </SplitView>
</Page>
