<Page
    x:Class="Lumen.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- ===== Sent message: accent bubble, tail bottom-right (W10M Messaging) ===== -->
        <DataTemplate x:Key="UserTemplate" x:DataType="core:ChatMessage">
            <StackPanel Margin="64,4,12,6" HorizontalAlignment="Right" Background="Transparent" RightTapped="UserMessage_RightTapped">
                <Border Background="{StaticResource UserBubbleSolid}" Padding="12,8,12,10">
                    <StackPanel>
                        <Image Source="{x:Bind Thumb, Mode=OneWay}" Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                               MaxHeight="240" MaxWidth="240" Stretch="Uniform" Margin="0,2,0,6" HorizontalAlignment="Left"/>
                        <Button Visibility="{x:Bind AudioVisibility}" Click="PlayAudio_Click" Background="#33000000"
                                BorderThickness="0" Padding="10,6" Margin="0,2,0,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind PlayIcon, Mode=OneWay}" FontSize="16" Foreground="White" Margin="0,0,10,0"/>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="15" Foreground="#CCFFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Bind AudioLabel}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind TextVisibility}" TextWrapping="Wrap" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 16,0 16,12" Fill="{StaticResource UserBubbleSolid}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Lumen's message: system grey bubble, tail top-left (W10M Messaging) ===== -->
        <DataTemplate x:Key="ModelTemplate" x:DataType="core:ChatMessage">
            <StackPanel Margin="12,4,40,6" HorizontalAlignment="Left" Background="Transparent" RightTapped="ModelMessage_RightTapped">
                <Polygon Points="0,0 0,12 16,12" Fill="{StaticResource ModelBubbleSolid}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                <Border Background="{StaticResource ModelBubbleSolid}" Padding="12,9,12,11" MinWidth="64">
                    <StackPanel>
                        <!-- W10M "marching dots" while thinking: runs on the compositor, smooth even when the UI thread is busy -->
                        <ProgressBar Width="72" Height="10" Margin="0,6,0,6" HorizontalAlignment="Left" Background="Transparent"
                                     Foreground="{StaticResource AccentTextBrush}" IsIndeterminate="{x:Bind IsThinking, Mode=OneWay}"
                                     Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEA80;" FontSize="14" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind StreamingVisibility, Mode=OneWay}"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <RichTextBlock core:Markdown.Source="{Binding RenderedText}" Visibility="{x:Bind RenderedVisibility, Mode=OneWay}"
                                       Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="False" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="520"/>
                        </StackPanel>

                        <!-- generated image -->
                        <Grid Visibility="{x:Bind ImageVisibility, Mode=OneWay}" Margin="0,8,0,2" HorizontalAlignment="Left">
                            <Image Source="{x:Bind Thumb, Mode=OneWay}" MaxWidth="300" MaxHeight="400" Stretch="Uniform" Tapped="GeneratedImage_Tapped"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                <Button Style="{StaticResource IconButton}" Width="38" Height="38" Background="#99000000" Click="SaveImage_Click" Margin="0,0,6,0">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="18" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="38" Height="38" Background="#99000000" Click="ShareImage_Click">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72D;" FontSize="18" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- generated file -->
                        <Grid Visibility="{x:Bind DocVisibility, Mode=OneWay}" Background="{StaticResource BgBrush}" Padding="10" Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="22" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DocName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind DocSizeLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" MinHeight="0" Padding="4,6" Margin="0,0,20,0" Click="OpenDoc_Click" Foreground="{StaticResource AccentTextBrush}">
                                    <StackPanel Orientation="Horizontal"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" FontSize="16" Margin="0,0,6,0"/><TextBlock x:Uid="XOpen" Text="Open"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" MinHeight="0" Padding="4,6" Margin="0,0,20,0" Click="SaveDoc_Click" Foreground="{StaticResource AccentTextBrush}">
                                    <StackPanel Orientation="Horizontal"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="16" Margin="0,0,6,0"/><TextBlock x:Uid="XSave" Text="Save"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" MinHeight="0" Padding="4,6" Click="ShareDoc_Click" Foreground="{StaticResource AccentTextBrush}">
                                    <StackPanel Orientation="Horizontal"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72D;" FontSize="16" Margin="0,0,6,0"/><TextBlock x:Uid="XShare" Text="Share"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <core:MessageTemplateSelector x:Key="MessageSelector"
                                      UserTemplate="{StaticResource UserTemplate}"
                                      ModelTemplate="{StaticResource ModelTemplate}"/>

        <Style x:Key="FlatListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Hamburger shell, the way Windows 10 Mobile apps (Mail, Groove, MSN) do it -->
        <SplitView x:Name="Shell" DisplayMode="Overlay" OpenPaneLength="300" PaneBackground="{StaticResource PaneBrush}" IsPaneOpen="False">
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="Hamburger_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="20"/>
                        </Button>
                        <TextBlock Text="LUMEN" Style="{StaticResource AppTitle}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Row="1" Style="{StaticResource ChipButton}" Padding="0" Click="NewChat_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Uid="XNewChat" Grid.Column="1" Text="New chat" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Button>

                    <TextBox x:Uid="XSearchChatsPlaceholderText" x:Name="SearchBox" Grid.Row="2" PlaceholderText="Search chats"
                             TextChanged="SearchBox_TextChanged" Margin="12,6,12,8"/>

                    <ListView x:Name="ConversationsList" Grid.Row="3" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Conversation_ItemClick" ShowsScrollingPlaceholders="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="56"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ConversationInfo">
                                <Grid Background="Transparent" RightTapped="Conversation_RightTapped" Padding="0,6,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BD;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="15"/>
                                        <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,2,0,0">
                                        <TextBlock Text="{x:Bind UpdatedLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource AccentTextBrush}"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{x:Bind PinVisibility, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="XNoChatsYet" x:Name="NoChats" Grid.Row="3" Text="No chats yet" Margin="56,8,12,0"
                               Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>

                    <StackPanel Grid.Row="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource ChipButton}" Padding="0" Click="Settings_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="XSettings" Grid.Column="1" Text="Settings" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: hamburger, chat title + model (tap to switch), new chat -->
                <Grid Background="{StaticResource ChromeBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Click="Hamburger_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="20"/>
                    </Button>
                    <Button x:Name="ModelButton" Grid.Column="1" Style="{StaticResource ChipButton}" Padding="4,0" MinHeight="48" Click="ModelButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Lumen" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                <TextBlock x:Name="ModelLabel" FontSize="12" Foreground="{StaticResource AccentTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="12" Grid.Column="1" Margin="8,14,0,0"
                                        VerticalAlignment="Top" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="NewChat_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="20"/>
                    </Button>
                </Grid>

                <ListView x:Name="MessagesList" Grid.Row="1"
                          ItemTemplateSelector="{StaticResource MessageSelector}"
                          ItemContainerStyle="{StaticResource FlatListItem}"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ShowsScrollingPlaceholders="False" Padding="0,8,0,8" FontSize="15">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent"/>
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <!-- Empty state: greeting + suggestions as a plain W10M list -->
                <ScrollViewer x:Name="EmptyState" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Padding="0,20,0,12">
                        <TextBlock x:Name="GreetingText" FontSize="28" FontWeight="SemiLight" TextWrapping="Wrap" Margin="12,0,12,0"/>
                        <TextBlock x:Uid="XWhatCanIHelpWithToday" x:Name="EmptySubtitle" Text="What can I help with today?" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,2,12,18"/>

                        <Grid x:Name="NoKeyCard" Background="{StaticResource ChromeBrush}" Padding="12" Margin="12,0,12,14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D7;" FontSize="20" Foreground="White"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="XConnectAnAiService" Text="Connect an AI service" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Uid="XAddAKeyForGeminiFreeClaudeOrChatgptInSet" Style="{StaticResource HintText}" Margin="0,4,0,12"
                                           Text="Add a key for Gemini (free), Claude or ChatGPT in Settings."/>
                                <Button x:Uid="XSetUpContent" Content="Set up" Click="Settings_Click" Style="{StaticResource AccentButton}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Uid="XTryAsking" x:Name="SuggestHeader" Text="Try asking" Style="{StaticResource SectionHeader}" Margin="12,0,12,4"/>
                        <StackPanel x:Name="SuggestionsPanel">
                            <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="40"/></TransitionCollection></StackPanel.ChildrenTransitions>
                            <Button x:Name="Suggest1" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                            <Button x:Name="Suggest2" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                            <Button x:Name="Suggest3" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                            <Button x:Name="Suggest4" Style="{StaticResource ChipButton}" Click="Suggestion_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Composer: attach, text box, send/voice (W10M Messaging) -->
                <Grid x:Name="Composer" Grid.Row="2" Background="{StaticResource ChromeBrush}" Padding="0,4,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="AttachmentPreview" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="12,4,0,8" HorizontalAlignment="Left">
                        <Image x:Name="AttachmentImage" Width="76" Height="76" Stretch="UniformToFill"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,-8,-8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{StaticResource AccentBrush}" Click="RemoveAttachment_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" Foreground="White"/>
                        </Button>
                    </Grid>

                    <Button x:Name="AttachButton" Grid.Row="1" Style="{StaticResource IconButton}" VerticalAlignment="Bottom">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="20"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem x:Uid="XTakeAPhoto" Text="Take a photo" Click="Camera_Click">
                                    <MenuFlyoutItem.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE722;" FontSize="20"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="XChooseFromGallery" Text="Choose from gallery" Click="Gallery_Click">
                                    <MenuFlyoutItem.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB9F;" FontSize="20"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="XCreateAnImage" Text="Create an image" Click="AskImage_Click">
                                    <MenuFlyoutItem.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE91B;" FontSize="20"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="XCreateAFile" Text="Create a file" Click="AskFile_Click">
                                    <MenuFlyoutItem.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C3;" FontSize="20"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBox x:Uid="XTypeAMessagePlaceholderText" x:Name="InputBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Type a message"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="132" FontSize="15" VerticalAlignment="Center"
                             TextChanged="InputBox_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Chat"/>
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>

                    <!-- Recording bar, replaces the text box while the mic is on -->
                    <Grid x:Name="RecordingBar" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Background="{StaticResource Surface2Brush}" Padding="12,0,0,0" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FFE81123" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RecordTime" Grid.Column="1" Text="0:00" FontSize="15" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Height="40" Click="CancelRecording_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <Button x:Name="SendButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Bottom"
                            Foreground="{StaticResource AccentTextBrush}" Click="Send_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="22" x:Name="SendGlyph"/>
                    </Button>
                </Grid>

            </Grid>
        </SplitView>

        <!-- In-app notification banner (W10M toast style) -->
        <Grid x:Name="Toast" VerticalAlignment="Top" Background="{StaticResource PaneBrush}" Padding="12,12,12,12"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Visibility="Collapsed" Tapped="Toast_Tapped">
            <Grid.RenderTransform><TranslateTransform x:Name="ToastMove"/></Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" Background="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="18" x:Name="ToastIcon" Foreground="White"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Lumen" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="ToastText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
