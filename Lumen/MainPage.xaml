<Page
    x:Class="Lumen.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumen.Core"
    Background="{StaticResource BgBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- ===== Sent message: accent bubble, tail bottom-right (Windows Phone Messaging) ===== -->
        <DataTemplate x:Key="UserTemplate" x:DataType="core:ChatMessage">
            <StackPanel Margin="64,4,12,6" HorizontalAlignment="Right" Background="Transparent" RightTapped="UserMessage_RightTapped">
                <Border Background="{StaticResource UserBubbleSolid}" Padding="12,8,12,10">
                    <StackPanel>
                        <Image Source="{x:Bind Thumb, Mode=OneWay}" Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                               MaxHeight="240" MaxWidth="240" Stretch="Uniform" Margin="0,2,0,6" HorizontalAlignment="Left"/>
                        <Button Visibility="{x:Bind AudioVisibility}" Click="PlayAudio_Click" Background="#33000000"
                                BorderThickness="0" Padding="10,6" Margin="0,2,0,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <BitmapIcon UriSource="{x:Bind PlayIcon, Mode=OneWay}" Width="16" Height="16" Foreground="White" Margin="0,0,10,0"/>
                                <BitmapIcon UriSource="ms-appx:///Assets/Icons/Mic.png" Width="15" Height="15" Foreground="#CCFFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Bind AudioLabel}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind TextVisibility}" TextWrapping="Wrap" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 16,0 16,12" Fill="{StaticResource UserBubbleSolid}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Lumen's message: deeper accent bubble, tail top-left ===== -->
        <DataTemplate x:Key="ModelTemplate" x:DataType="core:ChatMessage">
            <StackPanel Margin="12,4,40,6" HorizontalAlignment="Left" Background="Transparent" RightTapped="ModelMessage_RightTapped">
                <Polygon Points="0,0 0,12 16,12" Fill="{StaticResource ModelBubbleSolid}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                <Border Background="{StaticResource ModelBubbleSolid}" Padding="12,9,12,11" MinWidth="64">
                    <StackPanel>
                        <core:TypingIndicator Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                            <BitmapIcon UriSource="ms-appx:///Assets/Icons/Sparkle.png" Width="14" Height="14" Foreground="#CCFFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="13" FontStyle="Italic" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind StreamingVisibility, Mode=OneWay}"
                                   TextWrapping="Wrap" Foreground="White"/>
                        <RichTextBlock core:Markdown.Source="{Binding RenderedText}" Visibility="{x:Bind RenderedVisibility, Mode=OneWay}"
                                       Foreground="White" IsTextSelectionEnabled="False" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}">
                            <BitmapIcon UriSource="ms-appx:///Assets/Icons/Warning.png" Width="16" Height="16" Foreground="#FFFFD0CC" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="14" Foreground="#FFFFD0CC" MaxWidth="520"/>
                        </StackPanel>

                        <!-- generated image -->
                        <Grid Visibility="{x:Bind ImageVisibility, Mode=OneWay}" Margin="0,8,0,2" HorizontalAlignment="Left">
                            <Image Source="{x:Bind Thumb, Mode=OneWay}" MaxWidth="300" MaxHeight="400" Stretch="Uniform" Tapped="GeneratedImage_Tapped"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                <Button Style="{StaticResource IconButton}" Width="38" Height="38" Background="#99000000" Click="SaveImage_Click" Margin="0,0,6,0">
                                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Save.png" Width="18" Height="18" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="38" Height="38" Background="#99000000" Click="ShareImage_Click">
                                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Share.png" Width="18" Height="18" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- generated file -->
                        <Grid Visibility="{x:Bind DocVisibility, Mode=OneWay}" Background="#33000000" Padding="10" Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="42" Height="42" Background="#33FFFFFF" Margin="0,0,12,0">
                                <BitmapIcon UriSource="ms-appx:///Assets/Icons/Document.png" Width="22" Height="22" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DocName, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind DocSizeLabel, Mode=OneWay}" FontSize="12" Foreground="#CCFFFFFF"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Padding="0,6" Margin="0,0,20,0" Click="OpenDoc_Click" Foreground="White">
                                    <StackPanel Orientation="Horizontal"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Open.png" Width="16" Height="16" Margin="0,0,6,0" Foreground="White"/><TextBlock x:Uid="XOpen" Text="Open"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Padding="0,6" Margin="0,0,20,0" Click="SaveDoc_Click" Foreground="White">
                                    <StackPanel Orientation="Horizontal"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Save.png" Width="16" Height="16" Margin="0,0,6,0" Foreground="White"/><TextBlock x:Uid="XSave" Text="Save"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Padding="0,6" Click="ShareDoc_Click" Foreground="White">
                                    <StackPanel Orientation="Horizontal"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Share.png" Width="16" Height="16" Margin="0,0,6,0" Foreground="White"/><TextBlock x:Uid="XShare" Text="Share"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <core:MessageTemplateSelector x:Key="MessageSelector"
                                      UserTemplate="{StaticResource UserTemplate}"
                                      ModelTemplate="{StaticResource ModelTemplate}"/>

        <Style x:Key="FlatListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
    </Page.Resources>

    <!-- ============ App bar: the Windows Phone way ============ -->
    <Page.BottomAppBar>
        <CommandBar x:Name="AppBar">
            <AppBarButton x:Uid="XlVoiceLabel" x:Name="SendButton" Label="voice" Click="Send_Click">
                <AppBarButton.Icon><BitmapIcon x:Name="SendGlyph" UriSource="ms-appx:///Assets/Icons/Mic.png"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="XlAttachLabel" x:Name="AttachButton" Label="attach">
                <AppBarButton.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Camera.png"/></AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem x:Uid="XTakeAPhoto" Text="Take a photo" Click="Camera_Click">
                            <MenuFlyoutItem.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Camera.png" Width="20" Height="20"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="XChooseFromGallery" Text="Choose from gallery" Click="Gallery_Click">
                            <MenuFlyoutItem.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Image.png" Width="20" Height="20"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="XCreateAnImage" Text="Create an image" Click="AskImage_Click">
                            <MenuFlyoutItem.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/ImageSparkle.png" Width="20" Height="20"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="XCreateAFile" Text="Create a file" Click="AskFile_Click">
                            <MenuFlyoutItem.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/DocumentAdd.png" Width="20" Height="20"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Uid="XlModelLabel" x:Name="ModelButton" Label="model" Click="ModelButton_Click">
                <AppBarButton.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Model.png"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="XlNewChatLabel" Label="new chat" Click="NewChat_Click">
                <AppBarButton.Icon><BitmapIcon UriSource="ms-appx:///Assets/Icons/Add.png"/></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="XlSettingsLabel" Label="settings" Click="Settings_Click"/>
                <AppBarButton x:Uid="XlWelcomeTourLabel" Label="welcome tour" Click="Tour_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot x:Name="MainPivot" Title="LUMEN" SelectionChanged="MainPivot_SelectionChanged">

            <!-- ============ chat ============ -->
            <PivotItem x:Uid="XlChatHeader" Header="chat" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,12,4">
                        <TextBlock x:Name="TitleText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                        <TextBlock Text="  &#183;  " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ModelLabel" FontSize="13" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>

                    <ListView x:Name="MessagesList" Grid.Row="1"
                              ItemTemplateSelector="{StaticResource MessageSelector}"
                              ItemContainerStyle="{StaticResource FlatListItem}"
                              SelectionMode="None" IsItemClickEnabled="False"
                              ShowsScrollingPlaceholders="False" Padding="0,4,0,8" FontSize="15">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent"/>
                        </ListView.Resources>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <!-- Empty state: greeting + suggestion live tiles -->
                    <ScrollViewer x:Name="EmptyState" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Padding="12,4,12,12">
                            <TextBlock x:Name="GreetingText" FontSize="34" FontWeight="Light" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="XWhatCanIHelpWithToday" x:Name="EmptySubtitle" Text="What can I help with today?" FontSize="20" FontWeight="SemiLight"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <Grid x:Name="NoKeyCard" Background="{StaticResource SurfaceBrush}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}"><BitmapIcon UriSource="ms-appx:///Assets/Icons/Key.png" Width="22" Height="22" Foreground="White"/></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="XAddYourFreeApiKey" Text="Add your free API key" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Uid="XCreateOneInAMinuteOnGoogleAiStudioThenPa" Style="{StaticResource HintText}" Margin="0,4,0,12"
                                               Text="Create one in a minute on Google AI Studio, then paste it in Settings. No credit card needed."/>
                                    <Button x:Uid="XSetUpContent" Content="Set up" Click="Settings_Click" Style="{StaticResource AccentButton}"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="SuggestionsPanel" Margin="-4,0,-4,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button x:Name="Suggest1" Style="{StaticResource TileButton}" Margin="4" Height="150" Click="Suggestion_Click"/>
                                <Button x:Name="Suggest2" Grid.Column="1" Style="{StaticResource TileButton}" Margin="4" Height="150" Click="Suggestion_Click"/>
                                <Button x:Name="Suggest3" Grid.Row="1" Style="{StaticResource TileButton}" Margin="4" Height="150" Click="Suggestion_Click"/>
                                <Button x:Name="Suggest4" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileButton}" Margin="4" Height="150" Click="Suggestion_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- ============ history ============ -->
            <PivotItem x:Uid="XlHistoryHeader" Header="history">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Uid="XSearchChatsPlaceholderText" x:Name="SearchBox" PlaceholderText="Search chats" TextChanged="SearchBox_TextChanged" Margin="0,0,0,8"/>
                    <ListView x:Name="ConversationsList" Grid.Row="1" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Conversation_ItemClick" ShowsScrollingPlaceholders="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ConversationInfo">
                                <Grid Background="Transparent" RightTapped="Conversation_RightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" Background="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="26" FontWeight="Light" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="21" FontWeight="SemiLight"/>
                                        <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,4,0,0">
                                        <TextBlock Text="{x:Bind UpdatedLabel, Mode=OneWay}" FontSize="13" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                        <BitmapIcon UriSource="ms-appx:///Assets/Icons/Pin.png" Width="14" Height="14" Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{x:Bind PinVisibility, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="NoChats" Grid.Row="1" VerticalAlignment="Top" Margin="0,24,0,0" Visibility="Collapsed">
                        <TextBlock x:Uid="XNoChatsYet" x:Name="NoChatsText" Text="No chats yet" FontSize="20" FontWeight="SemiLight" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Composer (chat pivot only) -->
        <Grid x:Name="Composer" Grid.Row="1" Padding="12,6,12,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="AttachmentPreview" Visibility="Collapsed" Margin="0,0,0,8" HorizontalAlignment="Left">
                <Image x:Name="AttachmentImage" Width="76" Height="76" Stretch="UniformToFill"/>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,-8,-8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource AccentBrush}" Click="RemoveAttachment_Click">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Dismiss.png" Width="12" Height="12" Foreground="White"/>
                </Button>
            </Grid>

            <TextBox x:Uid="XAskLumenPlaceholderText" x:Name="InputBox" Grid.Row="1" PlaceholderText="Ask Lumen"
                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="132" FontSize="15"
                     TextChanged="InputBox_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TextBox.InputScope>
                    <InputScope>
                        <InputScope.Names>
                            <InputScopeName NameValue="Chat"/>
                        </InputScope.Names>
                    </InputScope>
                </TextBox.InputScope>
            </TextBox>

            <!-- Recording bar, replaces the text box while the mic is on -->
            <Grid x:Name="RecordingBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" Padding="12,0,0,0" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FFE51400" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="RecordTime" Grid.Column="1" Text="0:00" FontSize="16" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CancelRecording_Click">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/Delete.png" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Grid>

        <!-- "Marching dots" while Lumen is answering -->
        <ProgressBar x:Name="BusyBar" VerticalAlignment="Top" Foreground="{StaticResource AccentBrush}" Background="Transparent"
                     IsIndeterminate="False" Visibility="Collapsed"/>

        <!-- Windows Phone style toast banner -->
        <Grid x:Name="Toast" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" Padding="14,12,14,12"
              Visibility="Collapsed" Tapped="Toast_Tapped">
            <Grid.RenderTransform><TranslateTransform x:Name="ToastMove"/></Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <BitmapIcon x:Name="ToastIcon" UriSource="ms-appx:///Assets/Icons/Check.png" Width="18" Height="18" Foreground="White" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="Lumen" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToastText" Grid.Column="2" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
